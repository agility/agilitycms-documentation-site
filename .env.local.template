AGILITY_GUID=
NEXT_PUBLIC_AGILITY_GUID=
AGILITY_API_FETCH_KEY=
AGILITY_API_PREVIEW_KEY=
AGILITY_SECURITY_KEY=
AGILITY_LOCALES=en-us
AGILITY_DEBUG=true

ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=
# Key with the `analytics` ACL for the algolia-search-analytics skill (the
# admin key works; a dedicated analytics key is safer). Server-side only.
ALGOLIA_ANALYTICS_API_KEY=

# PostHog product analytics (docs site). Leave NEXT_PUBLIC_POSTHOG_KEY empty to
# run uninstrumented. Host: us.i.posthog.com (US cloud) or eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Marketing instance (the marketing bar above the docs header) -----------
# The 2026 agilitycms.com instance. Only the pre-header MESSAGE is read from
# here; the bar's CTAs come from the docs instance's own `header` item, so docs
# decides where it links back to. Leave blank and the bar simply renders
# without a message — nothing breaks.
#
# ⚠️ No webhook reaches us from this instance, so the message is cached for
# hours, not days (lib/cms/getMainSiteContent.ts).
MAIN_AGILITY_SITE_GUID=
MAIN_AGILITY_SITE_API_FETCH_KEY=
MAIN_AGILITY_SITE_API_PREVIEW_KEY=
# Where main-site links point. Defaults to https://agilitycms.com when unset.
MAIN_AGILITY_SITE_URL=
# --- API explorer -----------------------------------------------------------
# Classic Content Manager base URL. Used by the API explorer to list the
# instances a signed-in visitor can reach and to resolve their Fetch API key.
# Defaults to https://manager.agilitycms.com when unset.
AGILITY_MANAGER_URL=

# LOCAL TESTING ONLY — a real AgilityAuthOWIN cookie value, so the signed-in
# explorer flows can be exercised on localhost.
#
# The cookie is scoped to .agilitycms.com, so a browser never sends it to
# localhost; this stands in for it. To get a value: sign in to
# app.agilitycms.com, then DevTools > Application > Cookies > agilitycms.com >
# AgilityAuthOWIN > copy the value.
#
# ⚠️ This is a live session credential. Treat it like a password: it is only
# read when AGILITY_DEV_AUTH_COOKIE is set AND the process is not on Vercel or
# CI AND the request host is localhost — but it should still never be set
# anywhere but your own machine, and it expires like any other session.
# LEAVE BLANK unless you are actively testing the explorer.
AGILITY_DEV_AUTH_COOKIE=
